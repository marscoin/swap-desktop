{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mars Swap",
  "version": "0.1.0",
  "identifier": "org.marscoin.swap",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mars Swap",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "BTC and MARS atomic swaps with your own keys",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/atomicswapd"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
